#Line Messaging API credentials
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app ID
LIFF_ID=

# LIFF 背景 Worker 無任務時的輪詢間隔（秒）
TASK_WORKER_POLL_SECONDS=3
# Heartbeat 每 60 秒更新一次；lease 15 分鐘，避免 CPU/GIL 暫時延遲誤判。
TASK_HEARTBEAT_SECONDS=60
TASK_LEASE_SECONDS=900
TASK_RECOVERY_SCAN_SECONDS=60
TASK_RECOVERY_BATCH_SIZE=10
TASK_MAX_ATTEMPTS=3
# 第 1 次失敗 60 秒後可重試，第 2 次為 5 倍（300 秒）。
TASK_RETRY_BASE_SECONDS=60

# LIFF 上傳完成後由 Web 服務立即觸發 Cloud Run Job。
# CLOUD_RUN_TASK_JOB_NAME 留空時停用（地端測試請保持空白）。
CLOUD_RUN_TASK_JOB_NAME=
CLOUD_RUN_TASK_JOB_REGION=asia-east1
CLOUD_RUN_TASK_JOB_PROJECT_ID=
CLOUD_RUN_TASK_JOB_TRIGGER_TIMEOUT_SECONDS=5

# LIFF 使用任務建立時的固定快照，不讀取 Web 動態 parameters。
LIFF_YOLO_WORLD_CONFIDENCE=0.15
LIFF_EXPORT_CONFIDENCE_THRESHOLD=0.5
LIFF_YOLO_IMGSZ=640

# MySQL Database Configuration
# DB_BACKEND: auto（預設）| json | mysql。auto = 有設 MYSQL_HOST 或
# MYSQL_UNIX_SOCKET 就用 MySQL，否則退回本機 JSON 檔。
DB_BACKEND=auto
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# 二選一：TCP（本機 docker=db、Cloud SQL Public IP、Auth Proxy=127.0.0.1）
MYSQL_HOST=
MYSQL_PORT=3306
# 或 Cloud Run / App Engine 掛 Cloud SQL 用 unix socket：
# MYSQL_UNIX_SOCKET=/cloudsql/<PROJECT>:<REGION>:<INSTANCE>
MYSQL_UNIX_SOCKET=

#LINE Login credentials
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=

# 真正的 SAM 自動分割參數
SAM_CHECKPOINT=models/mobile_sam.pt
SAM_MODEL_TYPE=vit_t
SAM_POINTS_PER_SIDE=
SAM_MIN_MASK_REGION_AREA=

# GCP
GCP_PROJECT=
GCS_PROJECT_ID=
CLOUD_SQL_INSTANCE=
DB_NAME=
DB_USER=
DB_PASSWORD=
GCS_BUCKET=
# 1 / true / yes / on 都會啟用；0 則將新檔存回本機 data 目錄。
USE_GCS=0


# 上傳請求大小限制 (位元組，預設 64MB)
MAX_CONTENT_LENGTH=67108864
